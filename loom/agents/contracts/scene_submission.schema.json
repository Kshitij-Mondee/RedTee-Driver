{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "scene_submission",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "beat"
 ],
 "properties": {
  "beat": {
   "type": "string"
  },
  "file": {
   "type": "string"
  },
  "source": {
   "type": "string",
   "minLength": 40,
   "description": "the complete file; leave it out to submit the draft your last lab_snapshot wrote (the same text is not paid for twice)"
  },
  "verified": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "unverified": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
