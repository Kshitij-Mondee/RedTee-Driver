{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "finding",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "severity",
  "stage",
  "what",
  "fix_route"
 ],
 "properties": {
  "severity": {
   "enum": [
    "blocker",
    "major",
    "minor"
   ]
  },
  "stage": {
   "type": "string"
  },
  "beat": {
   "type": "string"
  },
  "field": {
   "type": "string"
  },
  "region": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 4,
   "maxItems": 4
  },
  "what": {
   "type": "string",
   "minLength": 3
  },
  "evidence": {
   "type": "string"
  },
  "fix_route": {
   "enum": [
    "knowledge",
    "pedagogy",
    "script",
    "storyboard",
    "kit",
    "scene",
    "human",
    "engine"
   ]
  }
 }
}
