{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "result",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "task_id",
  "role",
  "status",
  "usage",
  "cost_usd",
  "turns",
  "tool_calls",
  "model",
  "provider"
 ],
 "properties": {
  "task_id": {
   "type": "string"
  },
  "role": {
   "type": "string"
  },
  "status": {
   "enum": [
    "accepted",
    "rejected",
    "budget",
    "limits",
    "error",
    "skipped"
   ]
  },
  "artifact": {
   "type": [
    "string",
    "null"
   ]
  },
  "errors": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "findings": {
   "type": "array",
   "items": {
    "$ref": "finding.schema.json"
   }
  },
  "usage": {
   "type": "object",
   "properties": {
    "input": {
     "type": "integer"
    },
    "cached": {
     "type": "integer"
    },
    "cache_write": {
     "type": "integer"
    },
    "output": {
     "type": "integer"
    },
    "thinking": {
     "type": "integer"
    }
   }
  },
  "cost_usd": {
   "type": "number"
  },
  "turns": {
   "type": "integer"
  },
  "tool_calls": {
   "type": "integer"
  },
  "repairs": {
   "type": "integer"
  },
  "model": {
   "type": "string"
  },
  "provider": {
   "type": "string"
  },
  "seconds": {
   "type": "number"
  },
  "trace": {
   "type": "string"
  },
  "note": {
   "type": "string"
  }
 }
}
