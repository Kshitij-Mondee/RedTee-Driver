{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge sheet (topic mode: the reviewed stand-in for a source document)",
  "type": "object",
  "required": ["topic", "facts", "review"],
  "properties": {
    "topic": {"type": "string"},
    "scope_note": {"type": "string"},
    "facts": {"type": "array", "minItems": 3, "items": {"type": "object",
      "required": ["id", "statement", "kind", "confidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^F[0-9]+$"},
        "statement": {"type": "string", "minLength": 10},
        "kind": {"enum": ["definition", "finding", "history", "number", "practice", "mechanism", "example", "caution"]},
        "confidence": {"enum": ["established", "mainstream", "contested"]},
        "numbers": {"type": "array", "items": {"type": "string"}},
        "terms": {"type": "array", "items": {"type": "string"}},
        "reference_hint": {"type": "string"},
        "caveat": {"type": "string"}
      }}},
    "not_claimed": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "object", "required": ["status"], "properties": {
      "status": {"enum": ["draft", "approved"]}, "by": {"type": "string"}, "note": {"type": "string"}}}
  }
}
