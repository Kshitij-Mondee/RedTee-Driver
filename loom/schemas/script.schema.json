{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Script: narration split into beats, each with its teaching job and visual intent",
  "type": "object",
  "required": ["title", "wpm_target", "sections", "beats"],
  "properties": {
    "title": {"type": "string"},
    "wpm_target": {"type": "number", "minimum": 110, "maximum": 175},
    "voice_speed": {"type": "object", "required": ["value", "why"], "additionalProperties": false,
      "description": "D-197: the narrator's speed, chosen inside the kind of video's range from the topic, how dense the narration is and who watches",
      "properties": {"value": {"type": "number", "minimum": 0.7, "maximum": 1.1}, "why": {"type": "string", "minLength": 10}}},
    "sections": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "title"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "role": {"type": "string"}}}},
    "beats": {"type": "array", "minItems": 4, "items": {"type": "object",
      "required": ["id", "section", "job", "narration", "on_screen", "visual_intent", "change_over_time", "animate_score", "treatment_hint", "grounding"],
      "properties": {
        "id": {"type": "string", "pattern": "^b[0-9]{2,3}[a-z]?$"},
        "section": {"type": "string"},
        "job": {"enum": ["hook", "orient", "define", "distinguish", "sequence", "relate", "quantify", "demonstrate", "check", "consolidate", "transition", "payoff", "scenario", "refute", "practice"]},
        "narration": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "on_screen": {"type": "array", "items": {"type": "string"}},
        "visual_intent": {"type": "string", "minLength": 10},
        "change_over_time": {"type": "boolean"},
        "animate_score": {"type": "number", "minimum": 0, "maximum": 1},
        "treatment_hint": {"enum": ["avatar", "template", "motion", "hybrid", "any"]},
        "grounding": {"type": "array", "items": {"type": "object", "required": ["claim"],
          "properties": {"claim": {"type": "string"}, "fact": {"type": "string"}, "source_anchor": {"type": "string"}, "hypothetical": {"type": "boolean"}}}},
        "hypothetical": {"type": "boolean"},
        "pause_after_s": {"type": "number", "minimum": 0, "maximum": 8},
        "recall": {"type": ["object", "null"]},
        "delivery": {"type": "string"},
        "concepts": {"type": "array", "items": {"type": "string"}},
        "misconception": {"type": "string"}
      }}}
  }
}
