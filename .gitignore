*.zip
# secrets and local config
.env
loom.config.json
.claude/settings.local.json
# reference material we study but never republish (CLAUDE.md rule 11)
docs/research/vision/inbox/
# copies of rendered films (blind test sets)
docs/research/**/blind/
docs/research/**/blind4/
# lessons go in as plans only: project.json, plan/, scenes/ code, the run log and small text reports
/projects/*/*
!/projects/*/project.json
!/projects/*/RUN_LOG.md
!/projects/*/plan/
!/projects/*/scenes/
!/projects/*/logs/
/projects/*/logs/*
!/projects/*/logs/decisions.jsonl
!/projects/*/logs/shuttle/
/projects/*/logs/shuttle/*
!/projects/*/logs/shuttle/report.md
!/projects/*/qa/
/projects/*/qa/*
!/projects/*/qa/review.json
!/projects/*/qa/report.json
!/projects/*/qa/defects.json
# no lesson images (frames, sheets, snapshots of rendered films)
/projects/**/*.jpg
/projects/**/*.jpeg
/projects/**/*.png
/projects/**/*.gif
/projects/**/*.webp
# blind-test answer keys (would reveal an unrated pair)
*blind_KEY*
